#!/usr/bin/env python3
"""verifier-auteurs [--fusion-github] <plage> <nom du pilote> <courriel du pilote> — contrôle D28 (CI).

--fusion-github (CI de main) : admet le committer « GitHub <noreply@github.com> » d'une fusion
faite sur GitHub, si l'auteur est le pilote.

Chaque commit de <plage> (ex. origin/main..<sha>) doit avoir le pilote pour auteur et
pour committer, sans Co-Authored-By, anthropic.com, « Generated with Claude Code » ni lien
de session (kit_commun.MOTIFS_D28).
Code 0 : conforme. Code 1 : au moins un écart. Code 2 : erreur (échouer fermé).
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import kit_commun as kc  # noqa: E402


def principal(args):
    fusion_github = bool(args) and args[0] == "--fusion-github"
    if fusion_github:
        args = args[1:]
    if len(args) != 3:
        sys.stderr.write("usage : verifier-auteurs [--fusion-github] <plage> <nom> <courriel>\n")
        return 2
    ecarts = kc.ecarts_d28(kc.racine_depot(os.getcwd()), *args, fusion_github=fusion_github)
    if ecarts:
        print("verifier-auteurs : D28 non respectée :\n- " + "\n- ".join(ecarts))
        return 1
    print("verifier-auteurs : commits au seul nom du pilote.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(principal(sys.argv[1:]))
    except Exception as e:
        sys.stderr.write("verifier-auteurs : erreur : %s : %s\n" % (type(e).__name__, e))
        sys.exit(2)
