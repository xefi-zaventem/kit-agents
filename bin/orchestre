#!/usr/bin/env python3
"""orchestre — version réduite (methode/architecture.md §5.1), lancée par l'humain.

Usage :
  orchestre [--depot <dépôt>] [--modele <modèle>] [--ci github|locale]
            [--sans-surveillance <plafond en $ par session>]

Depuis le checkout principal du dépôt, sur main et propre :
1. Lit feature_list.json à origin/main et choisit les fonctionnalités prêtes
   (non validées, dépendances validées).
2. Forme un lot parallèle selon methode/methode.md §2.10 : au plus 3 ; touches
   disjointes ; aucune dépendance entre elles ; une fonctionnalité qui touche un
   fichier partagé (contrats, migrations, réglages, CLAUDE.md) part seule ; tant
   qu'aucune fonctionnalité n'est validée (tranche exemplaire), une seule.
3. Pour chacune : « claude -p --worktree <id> » (worktree natif de Claude Code),
   sans --bare, avec --settings du dépôt, acceptEdits et --allowedTools explicite.
   --max-budget-usd seulement avec --sans-surveillance. Vérifie dans system/init la
   version (onFailure exige 2.1.295) et le worktree, puis que les hooks tournent
   (événements de hooks : system/init ne liste pas les hooks) ; sinon arrête la session.
4. Fusionne une par une, dans l'ordre de priorité, seulement si : passes est true
   sur la branche ; aucun ÉCHEC FIN DE SESSION ; CI verte (GitHub, ou locale :
   mêmes contrôles que le modèle de CI) ; /code-review sans problème bloquant ;
   taille du diff pas plus du double des autres du jalon. Tests complets après
   chaque fusion ; conflit ou rouge = pas de fusion, la fonctionnalité reste en file.
5. Écrit un récapitulatif (états, signalements, coût et taille du diff, coût total)
   dans .kit/ et sur la sortie standard.

Il ne choisit pas le modèle (--modele est le choix de l'humain), ne réessaie pas,
ne résout aucun conflit et ne modifie jamais feature_list.json.
"""
import argparse
import json
import os
import re
import statistics
import subprocess
import sys
import threading
import time

BIN = os.path.dirname(os.path.realpath(__file__))
KIT = os.path.dirname(BIN)
sys.path.insert(0, BIN)
import kit_commun as kc  # noqa: E402

MAX_AGENTS = 3
VERSION_MIN = (2, 1, 295)
PARTAGES = ("contrats/", "docs/contrats/", "migrations/", ".claude/", "CLAUDE.md")
SIGNAUX = ("TEST CONTESTÉ", "DEMANDE HUMAINE", "TROP GROS", "ÉCHEC FIN DE SESSION")
VIDES = ("aucun", "aucune", "non", "")
CONSIGNE_RELECTURE = (
    "Après la relecture, termine ta réponse par une seule ligne : « VERDICT : AUCUN BLOQUANT » "
    "si rien ne touche le fonctionnement, la sécurité ou les contrats, sinon « VERDICT : BLOQUANT ». "
    "Ignore le style.")
DELAI_CI = 1800


def git(args, cwd, verifier=True):
    r = subprocess.run(["git"] + args, cwd=cwd, capture_output=True, text=True)
    if verifier and r.returncode != 0:
        raise kc.Erreur("git " + " ".join(args) + " : " + r.stderr.strip())
    return r


def normaliser(chemin):
    return (chemin[2:] if chemin.startswith("./") else chemin).rstrip("/")


def chevauche(a, b):
    a, b = normaliser(a), normaliser(b)
    return a == b or a.startswith(b + "/") or b.startswith(a + "/") or not a or not b


def en_conflit(f, g):
    return (f["id"] in g["depends_on"] or g["id"] in f["depends_on"]
            or any(chevauche(a, b) for a in f["touches"] for b in g["touches"]))


def former_lot(liste, maximum=MAX_AGENTS):
    fonctions = kc.par_id(liste)
    pretes = sorted((f for f in liste["fonctionnalites"]
                     if not f["passes"] and all(fonctions[d]["passes"] for d in f["depends_on"])),
                    key=lambda f: (f["priorite"], f["id"]))
    if not any(f["passes"] for f in liste["fonctionnalites"]):
        return pretes[:1]  # tranche exemplaire : seule
    lot = []
    for f in pretes:
        partage = not f["touches"] or any(chevauche(t, p) for t in f["touches"] for p in PARTAGES)
        if partage:
            if not lot:
                return [f]
            continue
        if not any(en_conflit(f, g) for g in lot):
            lot.append(f)
        if len(lot) == maximum:
            break
    return lot


def version(texte):
    return tuple(int(x) for x in re.findall(r"\d+", texte or "")[:3])


class Session:
    """Une session « claude -p » d'agent de code, surveillée par ses événements."""

    def __init__(self, racine, f, args):
        self.f, self.id = f, f["id"]
        self.worktree = os.path.join(racine, ".claude", "worktrees", self.id)
        self.arret, self.resultat, self.hook_vu, self.stop_vu = None, None, False, False
        marquer = os.path.join(BIN, "marquer-valide")
        with open(os.path.join(KIT, "modeles", "prompts", "agent-de-code.md"), encoding="utf-8") as p:
            prompt = p.read().replace("{id}", self.id).replace("{marquer_valide}", marquer)
        outils = ["Read", "Edit", "Write", "Glob", "Grep", "Bash(git status *)",
                  "Bash(git diff *)", "Bash(git log *)", "Bash(git add *)",
                  "Bash(git commit *)", "Bash(./init.sh *)", "Bash(%s *)" % marquer]
        cmd = ["claude", "-p", prompt, "--worktree", self.id,
               "--output-format", "stream-json", "--verbose", "--include-hook-events",
               "--settings", os.path.join(racine, ".claude", "settings.json"),
               "--permission-mode", "acceptEdits", "--allowedTools", ",".join(outils)]
        if args.modele:
            cmd += ["--model", args.modele]
        if args.sans_surveillance is not None:
            cmd += ["--max-budget-usd", str(args.sans_surveillance)]
        os.makedirs(os.path.join(racine, ".kit", "sessions"), exist_ok=True)
        self.journal = open(os.path.join(racine, ".kit", "sessions", self.id + ".jsonl"), "w",
                            encoding="utf-8")
        env = dict(os.environ, KIT_FONCTIONNALITE=self.id)
        self.proc = subprocess.Popen(cmd, cwd=racine, env=env, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=self.journal, text=True)
        self.fil = threading.Thread(target=self.lire)
        self.fil.start()

    def arreter(self, raison):
        if not self.arret:
            self.arret = raison
            self.proc.kill()

    def lire(self):
        for ligne in self.proc.stdout:
            self.journal.write(ligne)
            try:
                e = json.loads(ligne)
            except ValueError:
                continue
            t, s = e.get("type"), e.get("subtype")
            if t == "system" and s == "init":
                if version(e.get("claude_code_version")) < VERSION_MIN:
                    self.arreter("Claude Code %s < 2.1.295 (onFailure inconnu)"
                                 % e.get("claude_code_version"))
                elif os.path.realpath(e.get("cwd", "")) != os.path.realpath(self.worktree):
                    self.arreter("la session ne tourne pas dans son worktree")
            elif t == "system" and s == "hook_started":
                if e.get("hook_event") == "PreToolUse":
                    self.hook_vu = True
                elif e.get("hook_event") == "Stop":
                    self.stop_vu = True
            elif t == "user":
                contenu = (e.get("message") or {}).get("content") or []
                for c in contenu if isinstance(contenu, list) else []:
                    if c.get("type") == "tool_result" and not c.get("is_error") \
                            and not self.hook_vu:
                        self.arreter("un outil a tourné sans hook PreToolUse : hooks non chargés")
            elif t == "result":
                self.resultat = e
        self.proc.wait()
        self.journal.close()

    def cout(self):
        return float((self.resultat or {}).get("total_cost_usd") or 0)


def evaluer(racine, s):
    """État de la branche après la session : validée ? signalements, taille du diff."""
    info = {"id": s.id, "jalon": s.f["jalon"], "cout": s.cout(), "taille": 0,
            "signaux": [], "raison": None, "branche": "agent/" + s.id}
    if s.arret:
        info["raison"] = "session arrêtée : " + s.arret
        return info
    if not os.path.isdir(s.worktree):
        info["raison"] = "worktree absent (session en échec)"
        return info
    if not s.resultat or s.resultat.get("is_error"):
        info["raison"] = "session en erreur : " + str((s.resultat or {}).get("subtype"))
    if not s.stop_vu:
        info["raison"] = info["raison"] or "hook fin-de-session non vu"
    branche = git(["rev-parse", "--abbrev-ref", "HEAD"], s.worktree).stdout.strip()
    if branche != info["branche"]:
        git(["branch", "-m", info["branche"]], s.worktree)
    if git(["status", "--porcelain"], s.worktree).stdout.strip():
        info["signaux"].append("modifications non commitées dans le worktree")
        info["raison"] = info["raison"] or "modifications non commitées"
    plage = kc.REFERENCE + "..." + info["branche"]
    for ligne in git(["diff", plage, "--", "claude-progress.txt"], racine).stdout.splitlines():
        if ligne.startswith("+") and not ligne.startswith("+++"):
            for signal in SIGNAUX:
                if ligne[1:].startswith(signal):
                    valeur = ligne[1:].split(":", 1)[-1].strip()
                    if valeur.split(" ")[0].lower().strip("()") not in VIDES:
                        info["signaux"].append(ligne[1:].strip())
    for ligne in git(["diff", "--numstat", plage, "--", ".", ":(exclude)claude-progress.txt"],
                     racine).stdout.splitlines():
        champs = ligne.split("\t")
        info["taille"] += sum(int(x) for x in champs[:2] if x.isdigit())
    liste = json.loads(git(["show", info["branche"] + ":" + kc.LISTE], racine).stdout)
    info["validee"] = kc.par_id(liste)[s.id]["passes"] is True
    if not info["validee"]:
        info["raison"] = info["raison"] or "non validée (passes reste false)"
    elif any(x.startswith("ÉCHEC FIN DE SESSION") for x in info["signaux"]):
        info["raison"] = info["raison"] or "ÉCHEC FIN DE SESSION"
    return info


def ci_locale(worktree):
    etapes = [["git", "diff", "--exit-code", kc.REFERENCE, "--", "tests/acceptance/"],
              [sys.executable, os.path.join(BIN, "verifier-diff-liste"), kc.REFERENCE, kc.LISTE]]
    if os.access(os.path.join(worktree, "init.sh"), os.X_OK):
        etapes.append(["./init.sh", "--ci"])
    etapes.append([sys.executable, os.path.join(BIN, "tout-verifier")])
    for etape in etapes:
        r = subprocess.run(etape, cwd=worktree, capture_output=True, text=True)
        if r.returncode != 0:
            return False, "CI locale rouge : %s\n%s" % (" ".join(etape[-2:]),
                                                     (r.stdout + r.stderr)[-1500:])
    return True, "CI locale verte"


def ci_github(racine, branche):
    git(["push", "-u", "origin", branche], racine)
    sha = git(["rev-parse", branche], racine).stdout.strip()
    fin = time.time() + DELAI_CI
    while time.time() < fin:
        r = subprocess.run(["gh", "run", "list", "--branch", branche, "--limit", "20",
                            "--json", "headSha,status,conclusion"],
                           cwd=racine, capture_output=True, text=True)
        if r.returncode != 0:
            return False, "gh run list : " + r.stderr.strip()
        runs = [x for x in json.loads(r.stdout or "[]") if x.get("headSha") == sha]
        if runs and all(x.get("status") == "completed" for x in runs):
            if all(x.get("conclusion") == "success" for x in runs):
                return True, "CI GitHub verte"
            return False, "CI GitHub rouge"
        time.sleep(20)
    return False, "CI GitHub sans résultat après %d min" % (DELAI_CI // 60)


def relire(racine, branche, args):
    """/code-review (fonction native) en mode -p sur la branche. Fusion permise seulement
    si la relecture ne rend aucun constat (« (none) ») ou un verdict « AUCUN BLOQUANT » ;
    tout autre texte laisse la branche à relire par l'humain."""
    cmd = ["claude", "-p", "/code-review low %s...%s" % (kc.REFERENCE, branche),
           "--output-format", "json", "--append-system-prompt", CONSIGNE_RELECTURE,
           "--allowedTools", ",".join(["Read", "Glob", "Grep"] + ["Bash(git %s *)" % c for c in (
               "diff", "log", "show", "status", "rev-parse", "merge-base", "branch")])]
    if args.modele:
        cmd += ["--model", args.modele]
    r = subprocess.run(cmd, cwd=racine, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                       env=dict(os.environ, KIT_SESSION="relecture"))
    try:
        sortie = json.loads(r.stdout)
    except ValueError:
        return None, 0.0, r.stdout + r.stderr
    texte = str(sortie.get("result") or "")
    cout = float(sortie.get("total_cost_usd") or 0)
    if sortie.get("is_error"):
        return None, cout, texte
    if texte.strip() == "(none)":  # réponse de /code-review sans aucun constat (essai, v2.1.328)
        return "AUCUN BLOQUANT", cout, texte
    verdicts = re.findall(r"VERDICT\s*:\s*(AUCUN BLOQUANT|BLOQUANT)", texte)
    return (verdicts[-1] if verdicts else None), cout, texte


def fusionner(racine, info, f):
    r = git(["merge", "--no-ff", "-m", "Fusion de %s : %s" % (f["id"], f["description"]),
             info["branche"]], racine, verifier=False)
    if r.returncode != 0:
        git(["merge", "--abort"], racine, verifier=False)
        return "conflit à la fusion : remise en file"
    t = subprocess.run([sys.executable, os.path.join(BIN, "tout-verifier")], cwd=racine,
                       capture_output=True, text=True)
    if t.returncode != 0:
        git(["reset", "--hard", "ORIG_HEAD"], racine)
        return "tests rouges après fusion : fusion annulée\n" + (t.stdout + t.stderr)[-1500:]
    git(["push", "origin", "HEAD:main"], racine)
    git(["worktree", "unlock", os.path.join(racine, ".claude", "worktrees", f["id"])], racine,
        verifier=False)
    git(["worktree", "remove", "--force", os.path.join(racine, ".claude", "worktrees", f["id"])],
        racine, verifier=False)
    return None


def recapitulatif(racine, infos, cout_relectures):
    lignes = ["# Récapitulatif d'orchestre — " + time.strftime("%Y-%m-%d %H:%M"), "",
              "| Fonctionnalité | État | Coût ($) | Diff (lignes) | Signalements |",
              "|---|---|---|---|---|"]
    for i in infos:
        etat = "fusionnée" if i.get("fusionnee") else (i["raison"] or "non fusionnée")
        lignes.append("| %s | %s | %.4f | %d | %s |" % (
            i["id"], etat.split("\n")[0], i["cout"], i["taille"], " ; ".join(i["signaux"]) or "—"))
    total = sum(i["cout"] for i in infos) + cout_relectures
    lignes += ["", "Coût des relectures /code-review : %.4f $" % cout_relectures,
               "**Coût total : %.4f $**" % total, ""]
    a_relire = [i for i in infos if not i.get("fusionnee") and i.get("validee")]
    if a_relire:
        lignes.append("Points de rendez-vous (branches à relire par le pilote) :")
        lignes += ["- %s : %s" % (i["branche"], i["raison"].split("\n")[0]) for i in a_relire]
    texte = "\n".join(lignes) + "\n"
    os.makedirs(os.path.join(racine, ".kit"), exist_ok=True)
    with open(os.path.join(racine, ".kit", "recapitulatif-%s.md" % time.strftime("%Y%m%d-%H%M%S")),
              "w", encoding="utf-8") as f:
        f.write(texte)
    print(texte)


def principal():
    p = argparse.ArgumentParser(description="Orchestre réduit du kit.")
    p.add_argument("--depot", default=".")
    p.add_argument("--modele")
    p.add_argument("--ci", choices=["github", "locale"], default="github")
    p.add_argument("--sans-surveillance", type=float, metavar="PLAFOND_USD")
    args = p.parse_args()

    racine = kc.racine_depot(args.depot)
    if git(["rev-parse", "--abbrev-ref", "HEAD"], racine).stdout.strip() != "main":
        raise kc.Erreur("le checkout principal doit être sur main")
    if git(["status", "--porcelain", "--untracked-files=no"], racine).stdout.strip():
        raise kc.Erreur("le checkout principal a des modifications non commitées")
    if not os.path.isfile(os.path.join(racine, ".claude", "settings.json")):
        raise kc.Erreur(".claude/settings.json absent : lancer l'installateur du kit")
    git(["fetch", "origin"], racine)
    git(["merge", "--ff-only", kc.REFERENCE], racine)
    liste = kc.charger_liste(kc.lire_a_la_reference(racine, kc.REFERENCE, kc.LISTE))
    lot = former_lot(liste)
    if not lot:
        print("orchestre : aucune fonctionnalité prête.")
        return 0
    print("orchestre : lot de %d : %s" % (len(lot), ", ".join(f["id"] for f in lot)))
    sessions = [Session(racine, f, args) for f in lot]
    for s in sessions:
        s.fil.join()
    infos = [evaluer(racine, s) for s in sessions]

    for i in infos:  # signal de dérive vers le lourd (methode.md §2.12)
        autres = [j["taille"] for j in infos if j is not i and j["jalon"] == i["jalon"]
                  and j["taille"] > 0]
        if i.get("validee"):
            if autres and i["taille"] > 2 * statistics.median(autres):
                i["signaux"].append("diff plus de deux fois plus gros que les autres du jalon")
                i["raison"] = i["raison"] or "taille du diff : relecture du responsable technique"

    cout_relectures = 0.0
    fonctions = {f["id"]: f for f in lot}
    for i in infos:
        if i["raison"]:
            continue
        s = next(x for x in sessions if x.id == i["id"])
        ok, message = ci_locale(s.worktree) if args.ci == "locale" else ci_github(racine, i["branche"])
        if not ok:
            i["raison"] = message
            continue
        verdict, cout, texte = relire(racine, i["branche"], args)
        cout_relectures += cout
        with open(os.path.join(racine, ".kit", "sessions", i["id"] + "-relecture.md"), "w",
                  encoding="utf-8") as f:
            f.write(texte)
        if verdict != "AUCUN BLOQUANT":
            i["raison"] = ("/code-review : problème bloquant" if verdict == "BLOQUANT"
                           else "/code-review sans verdict lisible : relecture humaine")
            continue
        i["raison"] = fusionner(racine, i, fonctions[i["id"]])
        i["fusionnee"] = i["raison"] is None
    recapitulatif(racine, infos, cout_relectures)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(principal())
    except Exception as e:
        sys.stderr.write("orchestre : arrêt : %s : %s\n" % (type(e).__name__, e))
        sys.exit(2)
