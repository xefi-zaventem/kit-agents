{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(tests/acceptance/**)",
      "Edit(feature_list.json)",
      "Edit(init.sh)",
      "Edit(.github/**)",
      "Edit(**/conftest.py)",
      "Edit(**/pytest.ini)",
      "Edit(**/.pytest.ini)",
      "Edit(**/pytest.toml)",
      "Edit(**/tox.ini)",
      "Edit(**/setup.cfg)",
      "Edit(**/pyproject.toml)",
      "Edit(**/sitecustomize.py)",
      "Edit(**/usercustomize.py)",
      "Edit(.claude/**)",
      "Edit(~/.claude/**)",
      "Read(.env*)",
      "Read(**/secrets/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyWrite": [
        "tests/acceptance",
        "feature_list.json",
        "init.sh",
        ".github",
        "conftest.py",
        "pytest.ini",
        ".pytest.ini",
        "pytest.toml",
        "tox.ini",
        "setup.cfg",
        "pyproject.toml",
        "sitecustomize.py",
        "usercustomize.py",
        "tests/conftest.py",
        "tests/pytest.ini",
        "tests/.pytest.ini",
        "tests/pytest.toml",
        "tests/tox.ini",
        "tests/setup.cfg",
        "tests/pyproject.toml",
        "tests/sitecustomize.py",
        "tests/usercustomize.py",
        ".claude",
        "~/.claude"
      ],
      "denyRead": [
        "**/secrets"
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org"
      ]
    },
    "excludedCommands": [
      "/opt/kit/bin/marquer-valide *"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/kit/hooks/garde-commandes /etc/kit/garde-commandes.json",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/kit/hooks/verrou-ressources /etc/kit/garde-commandes.json",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/kit/hooks/garde-secrets",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/kit/hooks/controles-rapides",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/kit/hooks/fin-de-session",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
