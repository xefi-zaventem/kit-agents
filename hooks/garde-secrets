#!/usr/bin/env python3
"""garde-secrets — hook PreToolUse sur Write, Edit, MultiEdit, NotebookEdit et Bash.

Refuse (code 2) un texte écrit ou une commande qui contient un secret en clair :
clé privée, jeton d'un fournisseur connu, ou mot de passe affecté en dur.
Le message dit à l'agent de passer par une variable d'environnement.

ÉCHOUER FERMÉ : entrée illisible ou erreur interne = refus.
Garde-fou contre l'erreur, pas contre un agent qui encode volontairement un secret.
"""
import json
import re
import sys

MOTIFS = [
    (r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----",
     "clé privée"),
    (r"\bAKIA[0-9A-Z]{16}\b", "clé d'accès AWS"),
    (r"\bgh[pousr]_[A-Za-z0-9]{36,}\b", "jeton GitHub"),
    (r"\bgithub_pat_[A-Za-z0-9_]{50,}\b", "jeton GitHub"),
    (r"\bglpat-[A-Za-z0-9_-]{20,}\b", "jeton GitLab"),
    (r"\bsk-ant-[A-Za-z0-9_-]{20,}", "clé d'API Anthropic"),
    (r"\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}", "clé d'API"),
    (r"\bxox[abposr]-[A-Za-z0-9-]{10,}", "jeton Slack"),
    (r"\bAIza[0-9A-Za-z_-]{35}\b", "clé d'API Google"),
    (r"(?i)\b[a-z0-9.+-]+://[^\s:/@]+:[^\s:/@]{6,}@", "mot de passe dans une URL"),
]
AFFECTATION = re.compile(
    r"(?i)\b(?:password|passwd|pwd|mot_de_passe|motdepasse|secret|client_secret|"
    r"api_key|apikey|token|access_token|auth_token)\b[\"']?\s*[:=]\s*[\"']([^\"'\s]{8,})[\"']")
FACTICE = re.compile(r"(?i)^[<$%{]|\.\.\.|xxxx|\*\*\*\*|exemple|example|changeme|"
                     r"placeholder|dummy|factice|a-remplacer|your[_-]")
COMPILES = [(re.compile(m), r) for m, r in MOTIFS]


def refuser(raison):
    sys.stderr.write(
        "Refusé par garde-secrets : " + raison + ".\n"
        "N'écris jamais un secret en clair (code, configuration, commande, commit). "
        "Lis-le depuis une variable d'environnement ou un fichier ignoré par git, "
        "et laisse une valeur factice dans les exemples.\n")
    sys.exit(2)


def textes(outil, entree):
    if outil == "Bash":
        return [entree.get("command", "")]
    if outil == "Write":
        return [entree.get("content", "")]
    if outil == "Edit":
        return [entree.get("new_string", "")]
    if outil == "MultiEdit":
        return [e.get("new_string", "") for e in entree.get("edits", [])]
    if outil == "NotebookEdit":
        return [entree.get("new_source", "")]
    return []


def principal():
    try:
        donnees = json.load(sys.stdin)
    except Exception:
        refuser("entrée illisible")
    outil = donnees.get("tool_name", "")
    entree = donnees.get("tool_input") or {}
    for texte in textes(outil, entree):
        if not isinstance(texte, str):
            refuser("contenu inattendu")
        for motif, raison in COMPILES:
            if motif.search(texte):
                refuser(raison)
        for m in AFFECTATION.finditer(texte):
            if not FACTICE.search(m.group(1)):
                refuser("mot de passe ou jeton affecté en dur")
    sys.exit(0)


if __name__ == "__main__":
    try:
        principal()
    except SystemExit:
        raise
    except Exception as e:
        refuser("erreur interne du garde (" + type(e).__name__ + ")")
